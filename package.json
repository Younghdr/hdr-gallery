{
  "name": "young-hung-hdr-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-public-assets.js",
    "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev",
    "prebuild": "node scripts/prepare-public-assets.js",
    "build": "cross-env NEXT_DIST_DIR=.next-build next build",
    "build:netlify": "node scripts/prepare-public-assets.js && cross-env NEXT_DIST_DIR=.next next build",
    "prebuild:github": "node scripts/prepare-public-assets.js",
    "build:github": "cross-env GITHUB_PAGES=1 NEXT_PUBLIC_BASE_PATH=/hdr-gallery NEXT_DIST_DIR=.next-github next build",
    "admin": "node local-tools/admin-server.js",
    "admin:lan": "cross-env HOST=0.0.0.0 node local-tools/admin-server.js",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false --incremental false"
  },
  "dependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "^5.15.1",
    "@photo-sphere-viewer/core": "^5.15.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
